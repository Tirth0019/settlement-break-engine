# Locked Day 0 per BUILD_PLAN.md L2/L3 — fill in and never change mid-build.
# Copy to .env. Providers MUST differ (sbe.config raises if equal).

# Investigator agent (L3) — pick one family
# Groq: llama-3.3-70b-versatile deprecated Aug 2026 → use openai/gpt-oss-120b
INVESTIGATOR_PROVIDER=          # anthropic | openai | groq | google
INVESTIGATOR_MODEL=             # e.g. openai/gpt-oss-120b | gemini-2.5-flash
INVESTIGATOR_API_KEY=

# Verifier agent (L4) — MUST be a different provider/family from investigator
# Example pair: investigator=anthropic, verifier=openai (or google)
VERIFIER_PROVIDER=
VERIFIER_MODEL=
VERIFIER_API_KEY=

# Both agents run at temperature 0 (BUILD_PLAN L5) — not configurable per-call,
# set here so it can't drift.
AGENT_TEMPERATURE=0

SBE_DB_PATH=./runs/sbe.db

# L3 pacing — see docs/INVESTIGATOR_QUOTA.md
INVESTIGATE_PER_RUN_CAP=40
INVESTIGATE_PACE_SECONDS=1.0
